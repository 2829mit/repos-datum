rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /leads/{leadId} {
      allow read, write: if true;
    }

    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
